{
  "version": 1,
  "colors": {
    "background": "#0E1117",
    "surface": "#171C25",
    "surfaceDeep": "#10141B",
    "surfaceRaised": "#222A36",
    "surfaceHover": "#2B3544",
    "surfacePressed": "#121821",
    "text": "#F4F7FB",
    "textMuted": "#9BA8BA",
    "textDisabled": "#667180",
    "primary": "#E7A93D",
    "primaryHover": "#F3B94F",
    "primaryPressed": "#C88928",
    "primaryText": "#17120A",
    "border": "#394455",
    "borderStrong": "#59677A",
    "focus": "#FFD178",
    "danger": "#D96363",
    "dangerActive": "#FF8A8A",
    "success": "#5ABB7C",
    "successActive": "#86E4A7",
    "attackAccent": "#E7A93D",
    "healthAccent": "#E06A62",
    "armorAccent": "#A8C7D8",
    "resourceAccent": "#F3C65B",
    "tierAccent": "#C38CE8"
  },
  "typography": {
    "fonts": {},
    "sizes": {
      "caption": 12,
      "body": 15,
      "button": 15,
      "heading": 19,
      "title": 30
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 20,
    "xl": 32
  },
  "shape": {
    "small": 5,
    "medium": 9,
    "large": 15,
    "round": 99
  },
  "components": {
    "button": {
      "fontSize": "button",
      "textColor": "text",
      "backgroundColor": "surfaceRaised",
      "borderColor": "border",
      "borderWidth": 1,
      "radius": "medium",
      "padding": { "horizontal": "md", "vertical": "sm" },
      "states": {
        "hover": { "backgroundColor": "surfaceHover" },
        "pressed": { "backgroundColor": "surfacePressed" },
        "disabled": { "textColor": "textDisabled", "opacity": 0.55 },
        "focus": { "borderColor": "focus", "borderWidth": 2 }
      }
    },
    "button.primary": {
      "textColor": "primaryText",
      "backgroundColor": "primary",
      "backgroundAsset": "assets/ui/button-primary.svg",
      "slice": { "left": 14, "top": 14, "right": 14, "bottom": 14 },
      "states": {
        "hover": { "backgroundColor": "primaryHover" },
        "pressed": { "backgroundColor": "primaryPressed" },
        "disabled": { "opacity": 0.5 }
      }
    },
    "unit-token": {
      "textColor": "text",
      "backgroundColor": "#00000000",
      "borderColor": "borderStrong",
      "borderWidth": 0,
      "states": { "disabled": { "opacity": 0.58 } }
    },
    "action-token": {
      "textColor": "text",
      "backgroundColor": "#00000000",
      "borderColor": "focus",
      "borderWidth": 0,
      "states": { "disabled": { "opacity": 0.58 } }
    },
    "unit-card-preview": {
      "fontSize": "body",
      "textColor": "text",
      "backgroundColor": "#00000000",
      "borderColor": "borderStrong",
      "borderWidth": 0
    },
    "action-card-preview": {
      "fontSize": "body",
      "textColor": "text",
      "backgroundColor": "#00000000",
      "borderColor": "focus",
      "borderWidth": 0
    },
    "leader-inspector": {
      "fontSize": "body",
      "textColor": "text",
      "backgroundColor": "surfaceDeep",
      "borderColor": "borderStrong",
      "borderWidth": 2,
      "radius": "large"
    },
    "power-tooltip": {
      "fontSize": "body",
      "textColor": "text",
      "backgroundColor": "surfaceDeep",
      "borderColor": "focus",
      "borderWidth": 2,
      "radius": "large"
    },
    "player-chip": {
      "backgroundColor": "#00000000",
      "borderColor": "borderStrong",
      "borderWidth": 0
    },
    "input": {
      "fontSize": "body",
      "textColor": "text",
      "backgroundColor": "surface",
      "borderColor": "border",
      "borderWidth": 1,
      "radius": "medium",
      "padding": { "horizontal": "md", "vertical": "sm" },
      "states": { "focus": { "borderColor": "focus", "borderWidth": 2 } }
    },
    "panel": {
      "backgroundColor": "surface",
      "borderColor": "border",
      "borderWidth": 1,
      "radius": "large",
      "padding": { "horizontal": "lg", "vertical": "lg" }
    },
    "drag.preview": { "opacity": 0.12 },
    "dropTarget.valid": {
      "backgroundColor": "#00000000",
      "borderColor": "success",
      "borderWidth": 2,
      "radius": "large",
      "padding": { "horizontal": "sm", "vertical": "sm" }
    },
    "dropTarget.valid.active": {
      "backgroundColor": "#00000000",
      "borderColor": "successActive",
      "borderWidth": 4,
      "radius": "large"
    },
    "dropTarget.invalid": {
      "backgroundColor": "#00000000",
      "borderColor": "danger",
      "borderWidth": 2,
      "radius": "large",
      "padding": { "horizontal": "sm", "vertical": "sm" }
    },
    "dropTarget.invalid.active": {
      "backgroundColor": "#00000000",
      "borderColor": "dangerActive",
      "borderWidth": 4,
      "radius": "large"
    }
  },
  "screens": {
    "launcher": { "backgroundColor": "background" },
    "preparation": { "backgroundColor": "background" },
    "combat": { "backgroundColor": "#090B10" }
  }
}
